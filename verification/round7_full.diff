++        (math.nan, True, "nan", None),
++        (math.nan, False, "nan", None),
++        (math.inf, True, "positive_infinity", None),
++        (math.inf, False, "positive_infinity", None),
++        (-math.inf, True, "negative_infinity", None),
++        (-math.inf, False, "negative_infinity", None),
++        (0.0, True, "finite", 0.0),
++        (-0.5, True, "finite", -0.5),
